{
    // 需要安装 cortex-debug 扩展（ms-vscode? 实为 marus25.cortex-debug）
    // 调试器：ST-Link V2/V3，接口 SWD
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/zhulkong.elf",
            "device": "STM32F401CC",
            "interface": "swd",
            "runToEntryPoint": "main",
            "preLaunchTask": "CMake: build (Debug)",
            "svdFile": "${workspaceFolder}/.vscode/STM32F401x.svd"
        }
    ]
}
